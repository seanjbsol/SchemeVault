@host = http://localhost:5080
@token =

### Health
GET {{host}}/health

### Register (creates a tenant)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "organisationName": "Humber Civils Ltd",
  "fullName": "Alex Harper",
  "email": "alex@humber.test",
  "password": "TestPassw0rd!"
}

### Login (demo tenant)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@schemevault.test",
  "password": "DemoPassw0rd!"
}

### Me
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

### Dashboard
GET {{host}}/api/dashboard
Authorization: Bearer {{token}}

### Schemes
GET {{host}}/api/schemes
Authorization: Bearer {{token}}

### Evidence
GET {{host}}/api/evidence
Authorization: Bearer {{token}}

### Create evidence
POST {{host}}/api/evidence
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Public Liability insurance certificate",
  "category": "Insurance",
  "notes": "Hiscox £10m",
  "expiresOn": "2027-03-31T00:00:00Z"
}

### Renewals
GET {{host}}/api/renewals
Authorization: Bearer {{token}}

### Billing entitlements
GET {{host}}/api/billing/entitlements
Authorization: Bearer {{token}}

### Create checkout session (Owner/Admin)
POST {{host}}/api/billing/checkout
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "successUrl": "https://schemevault.app/billing/success",
  "cancelUrl": "https://schemevault.app/billing/cancel"
}

### Customer portal session (Owner/Admin)
POST {{host}}/api/billing/portal
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "returnUrl": "https://schemevault.app/settings"
}

### Questionnaires (Pro)
GET {{host}}/api/questionnaires
Authorization: Bearer {{token}}

### Generate CHAS pack draft (Pro)
POST {{host}}/api/questionnaires/schemes/CHAS/responses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "generate": true,
  "answers": {
    "companyName": "Northern Plant Hire Ltd",
    "tradingAddress": "Unit 4, Estate Road, Grimsby, DN31 2TG",
    "headcount": "22",
    "workDescription": "Plant hire and operator supply.",
    "hsResponsible": "Alex Harper, director",
    "hsPolicy": "Yes",
    "elInsurance": "Aviva, expires 2027-03-31",
    "plInsurance": "Hiscox, £10m, expires 2027-03-31",
    "competence": "CSCS/CPCS checked against a training matrix.",
    "rams": "Supervisor drafts; director signs.",
    "accidents": "Accident book in the office; director decides RIDDOR with an adviser.",
    "firstAid": "Two appointed persons; kits in the office and vans.",
    "enforcement": "No"
  }
}

### Accidents (Pro)
GET {{host}}/api/accidents
Authorization: Bearer {{token}}

### Equipment overdue (Pro)
GET {{host}}/api/equipment?overdue=true
Authorization: Bearer {{token}}

